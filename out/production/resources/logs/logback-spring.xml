<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyyMMdd HH:mm:ss.SSS} [%thread] %-3level %logger{5} - %msg %n</pattern>
        </encoder>
    </appender>

    <!-- config for STDOUT and SAVE-TO-FILE -->
    <appender name="SAVE-TO-FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/manna.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <Pattern>
                %d{dd-MM-yyyy HH:mm:ss.SSS} [%thread] %-5level %logger{36}.%M - %msg%n
            </Pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>
                ${LOG_PATH}/admin/eatsuda_admin.log.%d{dd-MM-yyyy}_%i.txt.zip
            </fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>10</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>DEBUG</level>
        </filter>
    </appender>

    <appender name="ROLE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="com.trism.jesica.Util.RoleLogFilter"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"> <!-- rollover daily -->
            <fileNamePattern>${LOG_PATH}/admin/role/update-role-%d{yyyy-MM-dd}.%i.txt.zip</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP"> <!-- or whenever the file size reaches 100MB -->
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS}- %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="LOGIN" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <filter class="com.trism.jesica.Util.LoginLogFilter"/>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"> <!-- rollover daily -->
            <fileNamePattern>${LOG_PATH}/admin/login/login-info-%d{yyyy-MM-dd}.%i.txt.zip</fileNamePattern>
            <timeBasedFileNamingAndTriggeringPolicy
                    class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP"> <!-- or whenever the file size reaches 100MB -->
                <maxFileSize>100MB</maxFileSize>
            </timeBasedFileNamingAndTriggeringPolicy>
        </rollingPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS}- %msg%n</pattern>
        </encoder>
    </appender>



    <root level="info">
        <appender-ref ref="SAVE-TO-FILE" />
        <appender-ref ref="ROLE"/>
        <appender-ref ref="LOGIN"/>
        <appender-ref ref="STDOUT" />

        <springProfile name="local">
            <logger name="org.springframework.web" additivity="false" level="debug">
                <appender-ref ref="SAVE-TO-FILE" />
                <appender-ref ref="STDOUT" />
            </logger>

            <logger name="com.woorien.petview" additivity="false" level="debug">
                <appender-ref ref="SAVE-TO-FILE" />
                <appender-ref ref="STDOUT" />
            </logger>

            <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="trace">
                <appender-ref ref="SAVE-TO-FILE" />
                <appender-ref ref="STDOUT" />
            </logger>
            <logger name="org.hibernate.sql" level="debug">
                <appender-ref ref="SAVE-TO-FILE" />
                <appender-ref ref="STDOUT" />
            </logger>

            <logger name="org.hibernate.type.BasicTypeRegistry" level="WARN">
                <appender-ref ref="SAVE-TO-FILE" />
                <appender-ref ref="STDOUT" />
            </logger>
        </springProfile>

    </root>

</configuration>